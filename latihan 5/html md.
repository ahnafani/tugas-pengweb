    <main>

        <section class="pembuka">
            <div class="teks-pembuka">
                <p class="label">FRESH DRINKS EVERY DAY</p>
                <h2>Take a break,<br>have some matcha.</h2>
                <p>
                    Minuman segar dengan rasa matcha,
                    susu creamy, dan perpaduan rasa favorit lainnya.
                </p>
                <a href="#menu" class="tombol">Lihat Menu</a>
            </div>

            <img
                src="https://images.unsplash.com/photo-1515823064-d6e0c04616a7?auto=format&fit=crop&w=800&q=80"
                alt="Minuman matcha">
        </section>

        <section id="menu" class="bagian-menu">
            <div class="judul">
                <h2>Our Drinks</h2>
                <p>Pilih minuman yang cocok buat mood kamu hari ini.</p>
            </div>

            <div class="daftar-produk">

                <div class="produk">
                    <img src="https://images.unsplash.com/photo-1515823064-d6e0c04616a7?auto=format&fit=crop&w=500&q=80" alt="Classic Matcha Latte">
                    <div class="isi">
                        <h3>Classic Matcha</h3>
                        <p>Matcha dan susu dengan rasa lembut.</p>
                        <span>Rp20.000</span>
                    </div>
                </div>

                <div class="produk">
                    <img src="https://images.unsplash.com/photo-1546173159-315724a31696?auto=format&fit=crop&w=500&q=80" alt="Strawberry drink">
                    <div class="isi">
                        <h3>Strawberry Matcha</h3>
                        <p>Matcha dengan sentuhan rasa stroberi.</p>
                        <span>Rp24.000</span>
                    </div>
                </div>

                <div class="produk">
                    <img src="https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=500&q=80" alt="Iced latte">
                    <div class="isi">
                        <h3>Matcha Cream</h3>
                        <p>Matcha dingin dengan rasa creamy.</p>
                        <span>Rp23.000</span>
                    </div>
                </div>

                <div class="produk">
                    <img src="https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=500&q=80" alt="Kopi susu dingin">
                    <div class="isi">
                        <h3>Matcha Espresso</h3>
                        <p>Perpaduan matcha dan espresso.</p>
                        <span>Rp25.000</span>
                    </div>
                </div>

                <div class="produk">
                    <img src="https://images.unsplash.com/photo-1544145945-f90425340c7e?auto=format&fit=crop&w=500&q=80" alt="Minuman buah">
                    <div class="isi">
                        <h3>Honey Matcha</h3>
                        <p>Matcha dengan tambahan madu manis.</p>
                        <span>Rp22.000</span>
                    </div>
                </div>

                <div class="produk">
                    <img src="https://japanesetaste.co.uk/cdn/shop/files/Matcha_Lemonade_step5-2.jpg?v=1713165260&width=600"
                     alt="Iced Matcha Lemon">
                    <div class="isi">
                        <h3>Matcha Lemon</h3>
                        <p>Rasa matcha dengan sensasi lemon segar.</p>
                        <span>Rp21.000</span>
                    </div>
                </div>

            </div>
        </section>

        <section id="favorit" class="favorit">
            <h2><i class="fa-solid fa-heart"></i> Customer Favorites</h2>
            <p>Kalau baru pertama kali datang, coba menu ini dulu!</p>

            <ul>
                <li>Classic Matcha untuk pencinta rasa original.</li>
                <li>Strawberry Matcha untuk rasa manis dan segar.</li>
                <li>Matcha Espresso untuk pencinta kopi.</li>
            </ul>
        </section>

