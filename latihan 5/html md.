    <footer>
        <h3><i class="fa-solid fa-leaf"></i> Matcha Mood Café</h3>
        <p><i class="fa-brands fa-instagram"></i> @matchamood.cafe</p>
        <p>Open daily: 10.00 - 22.00</p>
